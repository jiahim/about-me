{
  "name": "jiahim-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:site": "pnpm --filter @jiahim/site dev",
    "dev:admin": "pnpm --filter @jiahim/admin dev",
    "build": "pnpm -r --if-present build",
    "build:site": "pnpm --filter @jiahim/site build",
    "build:admin": "pnpm --filter @jiahim/admin build",
    "test": "pnpm -r --if-present test && node --test tests/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@jiahim/site-schema": "workspace:*",
    "@types/node": "^22.20.1",
    "gray-matter": "4.0.3",
    "vitepress": "^1.6.4"
  },
  "pnpm": {
    "overrides": {
      "mdast-util-to-hast@<13.2.1": "13.2.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23"
    }
  }
}
