{
  "name": "@jiahim/site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @jiahim/site-schema build",
    "dev": "vitepress dev ../../docs --host 127.0.0.1 --port 5173",
    "prebuild": "pnpm --filter @jiahim/site-schema build",
    "build": "vitepress build ../../docs --outDir dist",
    "pretest": "pnpm --filter @jiahim/site-schema build",
    "test": "vitest run --root ../.. docs/.vitepress",
    "preview": "vitepress preview ../../docs --host 127.0.0.1 --port 4173 --outDir dist"
  },
  "dependencies": {
    "@jiahim/site-schema": "workspace:*",
    "@giscus/vue": "^3.1.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "3.2.4"
  }
}
