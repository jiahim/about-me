# 可选：公开站点本地预览地址
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5173

# 可选：显式指定要编辑的仓库；默认会从当前目录向上识别
LOCAL_REPOSITORY_ROOT=/absolute/path/to/about-me

# 默认 local。服务器经 Tailscale Serve 访问时改为 tailscale
ADMIN_ACCESS_MODE=local

# Tailscale 模式必填：tailscale serve 输出的无路径 HTTPS 地址
# ADMIN_PUBLIC_ORIGIN=https://editor.example-tailnet.ts.net

# Tailscale 模式必填：允许访问后管的 Tailscale 登录名，多个值用逗号分隔
# ADMIN_TAILSCALE_ALLOWED_USERS=owner@example.com
