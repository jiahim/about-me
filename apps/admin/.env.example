# 可选：公开站点本地预览地址
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5173

# 可选：显式指定要编辑的仓库；默认会从当前目录向上识别
LOCAL_REPOSITORY_ROOT=/absolute/path/to/about-me

# 默认 local。仅在用户自行管理的私有网络中直接访问时改为 private
ADMIN_ACCESS_MODE=local

# private 模式必填：浏览器实际打开的无路径地址
# ADMIN_ALLOWED_ORIGIN=http://feiniunas:3000

# 生产启动监听地址和端口；private 模式可监听全部接口或服务器的 Tailscale IP
# ADMIN_HOST=0.0.0.0
# PORT=3000
