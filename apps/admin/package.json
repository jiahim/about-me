{
  "name": "@jiahim/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @jiahim/site-schema build",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
